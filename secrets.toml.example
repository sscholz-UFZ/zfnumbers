# This is NOT read from disk on Streamlit Community Cloud - it is only a
# reference for what to paste into the dashboard.
#
# On share.streamlit.io: open your app > Settings > Secrets, and paste in
# the block below with the real password filled in, then Save. Streamlit
# Cloud stores it securely and makes it available to the app as
# st.secrets["nextcloud"]["share_password"] - it is never committed to
# GitHub and never visible in the app's own source.
#
# This step is entirely optional: skip it and the page will simply ask
# each visitor to type the share password in themselves instead.

[nextcloud]
share_password = "the-real-share-password"
